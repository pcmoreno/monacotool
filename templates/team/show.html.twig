{% extends 'base.html.twig' %}

{% block title %}{{ team.name }} — MonacoTool{% endblock %}

{% block body %}
<div class="min-h-full px-6 py-12">
    <div class="max-w-5xl mx-auto">
        <div class="flex justify-end mb-8">
            <a href="{{ path('app_team') }}" class="text-sm text-graphite-500 hover:text-graphite-700 transition">← Teams</a>
        </div>

        <div class="grid md:grid-cols-2 gap-6 mb-6 items-stretch">
            <div class="flex flex-col gap-6">
                <div class="rounded-xl bg-surface shadow ring-1 ring-graphite-200 p-6">
                    <h2 class="text-xs font-semibold text-graphite-400 uppercase tracking-widest mb-4">Team</h2>
                    <div class="flex items-center justify-between mb-4">
                        <p class="text-lg font-semibold text-graphite-900">{{ team.name }}</p>
                        <div class="flex items-center gap-2">
                            {% if is_granted('team.delete', team) %}
                                <button id="open-delete-team-modal"
                                        type="button"
                                        data-team-id="{{ team.id }}"
                                        data-team-name="{{ team.name }}"
                                        class="text-graphite-400 hover:text-red-600 transition"
                                        title="Delete team">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"/>
                                    </svg>
                                </button>
                            {% endif %}
                        </div>
                    </div>
                    {% if team.memberships is empty %}
                        <p class="text-sm text-graphite-400">No members yet.</p>
                    {% else %}
                        <ul class="space-y-2">
                            {% for membership in team.memberships %}
                                <li class="flex items-center justify-between">
                                    <span class="text-sm {{ membership.status.value == 'active' ? 'text-graphite-700' : 'text-graphite-400' }}">
                                        {{ membership.user.name ?? membership.user.email }}
                                    </span>
                                    <div class="flex items-center gap-2">
                                        {% if membership.status.value == 'pending' %}
                                            <span class="text-xs text-amber-500 font-medium">Invited</span>
                                        {% elseif membership.status.value == 'rejected' %}
                                            <span class="text-xs text-red-400 font-medium">Declined</span>
                                        {% endif %}
                                        <span class="text-xs text-graphite-400 font-medium">{{ membership.role.name }}</span>
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                    {% if is_granted('team.edit', team) %}
                        <button id="open-invite-modal"
                                type="button"
                                data-team-id="{{ team.id }}"
                                class="mt-3 w-full text-center text-primary-400 hover:text-primary-600 transition text-lg font-light select-none cursor-pointer">+</button>
                    {% endif %}
                </div>

                <div class="rounded-xl bg-surface shadow ring-1 ring-graphite-200 p-6 flex-1">
                    <h2 class="text-xs font-semibold text-graphite-400 uppercase tracking-widest mb-6">Stats</h2>
                    <dl class="space-y-6">
                        <div>
                            <dt class="text-sm text-graphite-500">Velocity (avg output)</dt>
                            <dd id="stat-velocity" class="text-3xl font-bold text-graphite-900 mt-1">{{ outputAverage|number_format(1) }}</dd>
                        </div>
                        <div>
                            <dt class="text-sm text-graphite-500">Standard Deviation</dt>
                            <dd id="stat-std-dev" class="text-3xl font-bold text-graphite-900 mt-1">{{ standardDeviation|number_format(3) }}</dd>
                        </div>
                    </dl>
                </div>
            </div>

            <div class="rounded-xl bg-surface shadow ring-1 ring-graphite-200 p-6 flex flex-col"
                 data-team-id="{{ team.id }}">
                <h2 class="text-xs font-semibold text-graphite-400 uppercase tracking-widest mb-4">Iterations</h2>
                <div class="overflow-y-auto max-h-[32.5rem] pr-4">
                    <table class="w-full text-sm">
                        <thead class="sticky top-0 bg-surface">
                            <tr class="text-left text-graphite-400 border-b border-graphite-100">
                                <th class="pb-3 font-medium w-8"></th>
                                <th class="pb-3 font-medium">End Date</th>
                                <th class="pb-3 font-medium text-right">Output</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-graphite-100">
                            {% for iteration in team.iterations %}
                                <tr>
                                    <td class="py-2.5 px-1">
                                        <button type="button" data-delete-iteration="{{ iteration.id }}" class="text-graphite-400 hover:text-red-500 transition">
                                            {% include 'icons/trash.html.twig' %}
                                        </button>
                                    </td>
                                    <td class="py-2.5 text-graphite-600 cursor-pointer hover:bg-primary-50 rounded px-1 transition"
                                        data-editable
                                        data-field="end_date"
                                        data-iteration-id="{{ iteration.id }}"
                                        data-value="{{ iteration.endDate|date('Y-m-d') }}">
                                        {{ iteration.endDate|date('Y-m-d') }}
                                    </td>
                                    <td class="py-2.5 text-graphite-900 font-semibold text-right cursor-pointer hover:bg-primary-50 rounded px-1 transition"
                                        data-editable
                                        data-field="output"
                                        data-iteration-id="{{ iteration.id }}"
                                        data-value="{{ iteration.output }}">
                                        {{ iteration.output }}
                                    </td>
                                </tr>
                            {% endfor %}
                            <tr id="add-iteration-trigger" class="cursor-pointer hover:bg-primary-50 transition">
                                <td colspan="3" class="py-2.5 px-1 text-center text-primary-400 hover:text-primary-600 text-lg font-light select-none">+</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="rounded-xl bg-surface shadow ring-1 ring-graphite-200 p-6">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-xs font-semibold text-graphite-400 uppercase tracking-widest">Forecasts</h2>
                <button id="open-forecast-modal" type="button"
                        {% if team.iterations|length < 2 %}
                            disabled
                            title="At least 2 iterations are required to run a forecast."
                        {% endif %}
                        class="rounded-md bg-primary-600 px-4 py-1.5 text-xs font-semibold text-white shadow hover:bg-primary-500 transition disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-primary-600">
                    Request Forecast
                </button>
            </div>
            {% if team.forecasts is empty %}
                <p id="forecasts-empty" class="text-sm text-graphite-400">No forecasts yet.</p>
            {% endif %}
            <table class="w-full text-sm {{ team.forecasts is empty ? 'hidden' : '' }}">
                <thead>
                    <tr class="text-left text-graphite-400 border-b border-graphite-100">
                        <th class="pb-3 font-medium w-16"></th>
                        <th class="pb-3 font-medium">Created</th>
                        <th class="pb-3 font-medium text-right">Target Output</th>
                        <th class="pb-3 font-medium text-right">Target Iterations</th>
                        <th class="pb-3 font-medium text-right">Probability of Success for the Required Target</th>
                    </tr>
                </thead>
                <tbody id="forecasts-tbody" class="divide-y divide-graphite-100">
                    {% for forecast in team.forecasts %}
                        <tr data-forecast-id="{{ forecast.id }}"
                            data-forecast='{{ {
                                id: forecast.id,
                                createdAt: forecast.createdAt|date('Y-m-d H:i'),
                                targetOutput: forecast.targetOutput,
                                targetIterations: forecast.targetIterations,
                                numberOfSimulations: forecast.numberOfSimulations,
                                result: forecast.result,
                                teamStatsSnapshot: forecast.teamStatsSnapshot,
                                sensitivityTable: forecast.sensitivityTable
                            }|json_encode|e('html_attr') }}'>
                            <td class="py-2.5">
                                <div class="flex items-center gap-2">
                                    <button type="button" data-show-forecast class="text-graphite-400 hover:text-graphite-600 transition">
                                        {% include 'icons/magnifier.html.twig' %}
                                    </button>
                                    <button type="button" data-delete-forecast="{{ forecast.id }}" class="text-graphite-400 hover:text-red-500 transition">
                                        {% include 'icons/trash.html.twig' %}
                                    </button>
                                </div>
                            </td>
                            <td class="py-2.5 text-graphite-600">{{ forecast.createdAt|date('Y-m-d H:i') }}</td>
                            <td class="py-2.5 text-graphite-900 font-semibold text-right">{{ forecast.targetOutput }}</td>
                            <td class="py-2.5 text-graphite-900 font-semibold text-right">{{ forecast.targetIterations }}</td>
                            <td class="py-2.5 text-graphite-900 font-semibold text-right">{{ forecast.result is not null ? (forecast.result * 100)|number_format(1) ~ '%' : '—' }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<div id="confirm-delete-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center">
    <div class="absolute inset-0 bg-black/50"></div>
    <div class="relative bg-surface rounded-xl shadow-xl p-8 w-full max-w-sm mx-4">
        <h2 class="text-xl font-bold text-graphite-900 mb-2">Confirm Delete</h2>
        <p class="text-sm text-graphite-500 mb-6">Are you sure you want to delete this? This action cannot be undone.</p>
        <div class="flex gap-3">
            <button id="confirm-delete-cancel" type="button"
                    class="flex-1 rounded-md px-4 py-2 text-sm font-semibold text-graphite-700 shadow ring-1 ring-graphite-300 hover:bg-graphite-50 transition">
                Cancel
            </button>
            <button id="confirm-delete-confirm" type="button"
                    class="flex-1 rounded-md bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow hover:bg-red-500 transition">
                Delete
            </button>
        </div>
    </div>
</div>

<div id="forecast-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center">
    <div id="forecast-backdrop" class="absolute inset-0 bg-black/50"></div>
    <div class="relative bg-surface rounded-xl shadow-xl p-8 w-full max-w-md mx-4">
        <button id="close-forecast-modal" type="button"
                class="absolute top-4 right-4 text-graphite-400 hover:text-graphite-600 transition text-xl leading-none">&times;</button>
        <h2 class="text-xl font-bold text-graphite-900 mb-2">Forecasting for team {{ team.name }}</h2>
        <p class="text-sm text-graphite-500 mb-6">
            The current velocity is {{ outputAverage|number_format(1) }} and the standard deviation is {{ standardDeviation|number_format(3) }}.
        </p>
        <div class="space-y-4">
            <div>
                <label for="forecast-target-output" class="block text-sm font-medium text-graphite-700 mb-1">Target Output</label>
                <input id="forecast-target-output" type="number" min="1" max="100000"
                       class="block w-full rounded-md border border-graphite-300 px-3 py-2 text-sm focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500">
            </div>
            <div>
                <label for="forecast-target-iterations" class="block text-sm font-medium text-graphite-700 mb-1">Target Iterations</label>
                <input id="forecast-target-iterations" type="number" min="1" max="100"
                       class="block w-full rounded-md border border-graphite-300 px-3 py-2 text-sm focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500">
            </div>
            <button id="forecast-submit" type="button"
                    data-team-id="{{ team.id }}"
                    class="w-full rounded-md bg-primary-600 px-5 py-2 text-sm font-semibold text-white shadow hover:bg-primary-500 transition">
                Forecast
            </button>
        </div>
    </div>
</div>

<div id="delete-team-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center">
    <div id="delete-team-backdrop" class="absolute inset-0 bg-black/50"></div>
    <div class="relative bg-surface rounded-xl shadow-xl p-8 w-full max-w-sm mx-4">
        <h2 class="text-xl font-bold text-graphite-900 mb-2">Delete Team</h2>
        <p class="text-sm text-graphite-500 mb-1">This will permanently delete the team and all its iterations and forecasts.</p>
        <p class="text-sm text-graphite-500 mb-4">Type <strong id="delete-team-name-hint" class="text-graphite-900"></strong> to confirm.</p>
        <input id="delete-team-confirm-input" type="text" autocomplete="off"
               class="block w-full rounded-md border border-graphite-300 px-3 py-2 text-sm mb-6 focus:border-red-500 focus:outline-none focus:ring-1 focus:ring-red-500">
        <div id="delete-team-error" class="hidden text-sm text-red-600 mb-4"></div>
        <div class="flex gap-3">
            <button id="delete-team-cancel" type="button"
                    class="flex-1 rounded-md px-4 py-2 text-sm font-semibold text-graphite-700 shadow ring-1 ring-graphite-300 hover:bg-graphite-50 transition">
                Cancel
            </button>
            <button id="delete-team-confirm" type="button" disabled
                    class="flex-1 rounded-md bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow hover:bg-red-500 transition disabled:opacity-40 disabled:cursor-not-allowed">
                Delete
            </button>
        </div>
    </div>
</div>

<div id="forecast-detail-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center">
    <div id="forecast-detail-backdrop" class="absolute inset-0 bg-black/50"></div>
    <div class="relative bg-surface rounded-xl shadow-xl p-8 w-full max-w-4xl mx-4 max-h-[90vh] overflow-y-auto">
        <button id="close-forecast-detail-modal" type="button"
                class="absolute top-4 right-4 text-graphite-400 hover:text-graphite-600 transition text-xl leading-none">&times;</button>
        <h2 class="text-xl font-bold text-graphite-900 mb-6">Forecast Detail</h2>

        <dl class="grid grid-cols-2 gap-x-6 gap-y-4 mb-6 text-sm">
            <div>
                <dt class="text-graphite-400">Created</dt>
                <dd id="fd-created-at" class="font-semibold text-graphite-900 mt-0.5"></dd>
            </div>
            <div class="text-right">
                <dt class="text-graphite-400">Simulations</dt>
                <dd id="fd-simulations" class="font-semibold text-graphite-900 mt-0.5"></dd>
            </div>
            <div>
                <dt class="text-graphite-400">Target Output</dt>
                <dd id="fd-target-output" class="font-semibold text-graphite-900 mt-0.5"></dd>
            </div>
            <div class="text-right">
                <dt class="text-graphite-400">Target Iterations</dt>
                <dd id="fd-target-iterations" class="font-semibold text-graphite-900 mt-0.5"></dd>
            </div>
            <div>
                <dt class="text-graphite-400">Velocity at time</dt>
                <dd id="fd-mean" class="font-semibold text-graphite-900 mt-0.5"></dd>
            </div>
            <div class="text-right">
                <dt class="text-graphite-400">Std Dev at time</dt>
                <dd id="fd-std-dev" class="font-semibold text-graphite-900 mt-0.5"></dd>
            </div>
            <div class="col-span-2 border-t border-graphite-100 pt-4 text-center">
                <dt class="text-xl font-bold text-graphite-900">Probability of Success for the Required Target</dt>
                <dd id="fd-result" class="text-2xl font-bold text-graphite-900 mt-0.5"></dd>
            </div>
        </dl>

        <h3 class="text-xs font-semibold text-graphite-400 uppercase tracking-widest mb-3">Iteration Range Analysis</h3>
        <div id="fd-sensitivity-loading" class="text-sm text-graphite-400">Computing…</div>
        <div class="overflow-x-auto">
        <table id="fd-sensitivity-table" class="hidden w-full text-sm rounded-lg overflow-hidden">
            <thead id="fd-sensitivity-thead"></thead>
            <tbody id="fd-sensitivity-tbody"></tbody>
        </table>
        </div>
    </div>
</div>

<div id="invite-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center">
    <div id="invite-backdrop" class="absolute inset-0 bg-black/50"></div>
    <div class="relative bg-surface rounded-xl shadow-xl p-8 w-full max-w-sm mx-4">
        <button id="close-invite-modal" type="button"
                class="absolute top-4 right-4 text-graphite-400 hover:text-graphite-600 transition text-xl leading-none">&times;</button>
        <h2 class="text-xl font-bold text-graphite-900 mb-6">Invite member</h2>
        <div class="space-y-4">
            <div>
                <label for="invite-name" class="block text-sm font-medium text-graphite-700 mb-1">Name</label>
                <input id="invite-name" type="text" autocomplete="off"
                       class="block w-full rounded-md border border-graphite-300 px-3 py-2 text-sm focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500">
            </div>
            <div>
                <label for="invite-email" class="block text-sm font-medium text-graphite-700 mb-1">Email</label>
                <input id="invite-email" type="email" autocomplete="off"
                       class="block w-full rounded-md border border-graphite-300 px-3 py-2 text-sm focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500">
            </div>
            <div id="invite-error" class="hidden text-sm text-red-600"></div>
            <button id="invite-submit" type="button"
                    data-team-id="{{ team.id }}"
                    class="w-full rounded-md bg-primary-600 px-5 py-2 text-sm font-semibold text-white shadow hover:bg-primary-500 transition">
                Send invitation
            </button>
        </div>
    </div>
</div>

<template id="icon-trash">{% include 'icons/trash.html.twig' %}</template>
<template id="icon-magnifier">{% include 'icons/magnifier.html.twig' %}</template>

<script type="module" src="{{ asset('iteration-edit.js') }}"></script>
<script type="module" src="{{ asset('forecast-modal.js') }}"></script>
<script type="module" src="{{ asset('invite-modal.js') }}"></script>
<script type="module" src="{{ asset('team-delete.js') }}"></script>
{% endblock %}
