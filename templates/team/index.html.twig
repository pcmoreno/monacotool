{% extends 'base.html.twig' %}

{% block title %}Teams — MonacoTool{% endblock %}

{% block body %}
<div class="min-h-full px-6 py-12">
    <div class="max-w-4xl mx-auto">
        <div class="flex items-center justify-between mb-8">
            <h1 class="text-3xl font-bold text-graphite-900">Teams — {{ app.user.name ?? app.user.email }}</h1>
            <div class="flex items-center gap-4">
                <button id="open-team-create-modal" type="button"
                        class="rounded-md bg-primary-600 px-4 py-1.5 text-xs font-semibold text-white shadow hover:bg-primary-500 transition">
                    Create a new team
                </button>
                <a href="{{ path('home') }}" class="text-sm text-graphite-500 hover:text-graphite-700 transition">← Home</a>
            </div>
        </div>

        <div id="teams-container">
            {% if teams is empty %}
                <div id="teams-empty" class="rounded-xl bg-surface shadow ring-1 ring-graphite-200 p-10 text-center">
                    <p class="text-graphite-400">You are not a member of any teams yet.</p>
                </div>
            {% else %}
                <div id="teams-grid" class="grid gap-4 sm:grid-cols-2">
                    {% for team in teams %}
                        <a href="{{ path('app_team_show', {id: team.id}) }}"
                           class="block rounded-xl bg-surface shadow ring-1 ring-graphite-200 p-6 hover:shadow-md transition">
                            <h2 class="text-lg font-semibold text-graphite-900">{{ team.name }}</h2>
                            <p class="text-sm text-graphite-500 mt-1">
                                {{ team.iterations|length }} iteration{{ team.iterations|length != 1 ? 's' : '' }}
                            </p>
                        </a>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</div>

{% set welcome_name = app.flashes('welcome')|first %}
{% if welcome_name %}
<div id="welcome-modal" class="fixed inset-0 z-50 flex items-center justify-center">
    <div class="absolute inset-0 bg-black/50"></div>
    <div class="relative bg-surface rounded-xl shadow-xl p-8 w-full max-w-sm mx-4 text-center">
        <button id="close-welcome-modal" type="button"
                class="absolute top-4 right-4 text-graphite-400 hover:text-graphite-600 transition text-xl leading-none">&times;</button>
        <h2 class="text-2xl font-bold text-graphite-900 mb-2">Welcome, {{ welcome_name }}!</h2>
        <p class="text-sm text-graphite-500 mb-6">Your account is verified. Create your first team to start forecasting.</p>
        <div class="flex flex-col gap-3">
            <button id="welcome-create-team" type="button"
                    class="w-full rounded-md bg-primary-600 px-5 py-2.5 text-sm font-semibold text-white shadow hover:bg-primary-500 transition">
                Create your first team
            </button>
            <button id="welcome-dismiss" type="button"
                    class="w-full rounded-md bg-surface px-5 py-2.5 text-sm font-semibold text-graphite-700 shadow ring-1 ring-graphite-300 hover:bg-graphite-50 transition">
                I'll look around first
            </button>
        </div>
    </div>
</div>
{% endif %}

<div id="team-create-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center">
    <div id="team-create-backdrop" class="absolute inset-0 bg-black/50"></div>
    <div class="relative bg-surface rounded-xl shadow-xl p-8 w-full max-w-sm mx-4">
        <button id="close-team-create-modal" type="button"
                class="absolute top-4 right-4 text-graphite-400 hover:text-graphite-600 transition text-xl leading-none">&times;</button>
        <h2 class="text-xl font-bold text-graphite-900 mb-6">Create a new team</h2>
        <div class="space-y-4">
            <div>
                <label for="team-create-name" class="block text-sm font-medium text-graphite-700 mb-1">Team name</label>
                <input id="team-create-name" type="text"
                       class="block w-full rounded-md border border-graphite-300 px-3 py-2 text-sm focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500">
            </div>
            <button id="team-create-submit" type="button"
                    class="w-full rounded-md bg-primary-600 px-5 py-2 text-sm font-semibold text-white shadow hover:bg-primary-500 transition">
                Create
            </button>
        </div>
    </div>
</div>

<script type="module" src="{{ asset('team-create.js') }}"></script>
{% endblock %}
