{% extends 'base.html.twig' %}

{% block title %}MonacoTool{% endblock %}

{% block body %}
<div class="min-h-screen grid grid-cols-3">
    <div></div>
    <div class="bg-surface px-10 pt-16 flex flex-col items-center">
    <div class="text-center w-full">
        <h1 class="text-5xl font-bold tracking-tight text-graphite-900 mb-4">MonacoTool</h1>
        <p class="text-lg text-graphite-500 mb-6">Simple Monte Carlo forecasting for agile teams. No spreadsheets, no guesswork.</p>
        <p class="text-sm text-graphite-500 mb-10">Add your team's past iteration outputs, pick a target, and MonacoTool runs thousands of simulations to tell you the probability of hitting it. The more iterations you log, the sharper the forecast.<br><br>Getting started takes two minutes — create an account and start logging iterations right away. Already have an account? Just log in.</p>

        {% if app.user %}
            <p class="text-sm text-graphite-500 mb-6">Logged in as <span class="font-medium text-graphite-700">{{ app.user.name ?? app.user.email }}</span></p>
            <div class="flex justify-center gap-4">
                <a href="{{ path('app_team') }}" class="rounded-md bg-primary-600 px-5 py-2.5 text-sm font-semibold text-white shadow hover:bg-primary-500 transition">Go to teams</a>
                <form method="post" action="{{ path('app_logout') }}" class="contents">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                    <button type="submit" class="rounded-md bg-surface px-5 py-2.5 text-sm font-semibold text-graphite-700 shadow ring-1 ring-graphite-300 hover:bg-graphite-50 transition">Logout</button>
                </form>
            </div>
        {% else %}
            <div class="flex justify-center gap-4">
                <a href="{{ path('app_login') }}" class="rounded-md bg-primary-600 px-6 py-3 text-sm font-semibold text-white shadow hover:bg-primary-500 transition">Login</a>
                <button id="open-register-modal" type="button"
                        class="rounded-md bg-surface px-6 py-3 text-sm font-semibold text-primary-600 shadow ring-1 ring-primary-600 hover:bg-primary-50 transition">
                    Create account
                </button>
            </div>
        {% endif %}
    </div>
    </div>
    <div></div>
</div>

{% if not app.user %}
<div id="check-inbox-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center" role="dialog" aria-modal="true" aria-labelledby="check-inbox-heading" aria-hidden="true">
    <div class="absolute inset-0 bg-black/50"></div>
    <div class="relative bg-surface rounded-xl shadow-xl p-8 w-full max-w-sm mx-4">
        <button id="close-check-inbox-modal" type="button"
                class="absolute top-4 right-4 text-graphite-400 hover:text-graphite-600 transition text-xl leading-none">&times;</button>
        <h2 id="check-inbox-heading" class="text-xl font-bold text-graphite-900 mb-2">Check your inbox</h2>
        <p class="text-sm text-graphite-500 mb-6">
            We sent a confirmation link to <span id="check-inbox-email" class="font-medium text-graphite-700"></span>.
            Click the link to activate your account.
        </p>
        <button id="resend-verification-btn" type="button"
                class="w-full rounded-md bg-surface px-5 py-2 text-sm font-semibold text-graphite-700 shadow ring-1 ring-graphite-300 hover:bg-graphite-50 transition">
            Resend email
        </button>
        <div id="resend-feedback" class="hidden mt-3 text-sm text-graphite-500 text-center"></div>
    </div>
</div>

<div id="register-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center" role="dialog" aria-modal="true" aria-labelledby="register-modal-heading" aria-hidden="true">
    <div id="register-backdrop" class="absolute inset-0 bg-black/50"></div>
    <div class="relative bg-surface rounded-xl shadow-xl p-8 w-full max-w-sm mx-4">
        <button id="close-register-modal" type="button"
                class="absolute top-4 right-4 text-graphite-400 hover:text-graphite-600 transition text-xl leading-none">&times;</button>
        <h2 id="register-modal-heading" class="text-xl font-bold text-graphite-900 mb-6">Create account</h2>

        <div id="register-errors" class="hidden mb-4 rounded-md bg-red-50 px-4 py-3 text-sm text-red-700 ring-1 ring-red-200 space-y-1"></div>

        <div class="space-y-4">
            <div>
                <label for="register-name" class="block text-sm font-medium text-graphite-700 mb-1">Name</label>
                <input id="register-name" type="text" autocomplete="name"
                       class="block w-full rounded-md border border-graphite-300 px-3 py-2 text-sm focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500">
            </div>
            <div>
                <label for="register-email" class="block text-sm font-medium text-graphite-700 mb-1">Email</label>
                <input id="register-email" type="email" autocomplete="email"
                       class="block w-full rounded-md border border-graphite-300 px-3 py-2 text-sm focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500">
            </div>
            <div>
                <label for="register-password" class="block text-sm font-medium text-graphite-700 mb-1">Password</label>
                <input id="register-password" type="password" autocomplete="new-password"
                       class="block w-full rounded-md border border-graphite-300 px-3 py-2 text-sm focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500">
            </div>
            <div>
                <label for="register-confirm" class="block text-sm font-medium text-graphite-700 mb-1">Confirm password</label>
                <input id="register-confirm" type="password" autocomplete="new-password"
                       class="block w-full rounded-md border border-graphite-300 px-3 py-2 text-sm focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500">
            </div>
            <button id="register-submit" type="button"
                    class="w-full rounded-md bg-primary-600 px-5 py-2 text-sm font-semibold text-white shadow hover:bg-primary-500 transition">
                Create account
            </button>
        </div>
    </div>
</div>

<script type="module" src="{{ asset('registration.js') }}"></script>
{% endif %}
{% endblock %}
