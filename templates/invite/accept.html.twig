{% extends 'base.html.twig' %}

{% block title %}Accept invitation — MonacoTool{% endblock %}

{% block body %}
<div class="min-h-full flex flex-col justify-center items-center px-6 py-24">
    <div class="w-full max-w-sm text-center">
        <h1 class="text-2xl font-bold text-graphite-900 mb-2">MonacoTool</h1>
        <p class="text-graphite-500 text-sm mb-8">You've been invited to join <strong class="text-graphite-700">{{ team.name }}</strong>.</p>

        <form method="post" class="bg-surface shadow rounded-xl px-8 py-8">
            <button type="submit"
                    class="w-full rounded-md bg-primary-600 px-5 py-2.5 text-sm font-semibold text-white shadow hover:bg-primary-500 transition">
                Accept invitation
            </button>
        </form>
    </div>
</div>
{% endblock %}
