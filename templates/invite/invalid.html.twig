{% extends 'base.html.twig' %}

{% block title %}Invalid invitation — MonacoTool{% endblock %}

{% block body %}
<div class="min-h-full flex flex-col justify-center items-center px-6 py-24">
    <div class="w-full max-w-sm text-center">
        <h1 class="text-2xl font-bold text-graphite-900 mb-2">MonacoTool</h1>
        {% if reason == 'expired' %}
            <p class="text-graphite-500 text-sm mb-4">This invitation link has expired.</p>
            <p class="text-graphite-400 text-sm">Ask the team admin to send you a new invitation.</p>
        {% else %}
            <p class="text-graphite-500 text-sm mb-4">This invitation link is invalid or has already been used.</p>
            <a href="{{ path('app_login') }}" class="text-sm text-primary-600 hover:underline">Go to login</a>
        {% endif %}
    </div>
</div>
{% endblock %}
