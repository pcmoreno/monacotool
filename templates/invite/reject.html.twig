{% extends 'base.html.twig' %}

{% block title %}Decline invitation — MonacoTool{% endblock %}

{% block body %}
<div class="min-h-full flex flex-col justify-center items-center px-6 py-24">
    <div class="w-full max-w-sm text-center">
        <h1 class="text-2xl font-bold text-graphite-900 mb-2">MonacoTool</h1>
        {% if inviterName %}
            <p class="text-graphite-500 text-sm mb-8">Are you sure you want to decline <strong class="text-graphite-700">{{ inviterName }}</strong>'s invitation to join <strong class="text-graphite-700">{{ team.name }}</strong>?</p>
        {% else %}
            <p class="text-graphite-500 text-sm mb-8">Are you sure you want to decline the invitation to join <strong class="text-graphite-700">{{ team.name }}</strong>?</p>
        {% endif %}

        <form method="post" class="bg-surface shadow rounded-xl px-8 py-8">
            <input type="hidden" name="_token" value="{{ csrf_token('invite_reject') }}">
            <button type="submit"
                    class="w-full rounded-md bg-red-600 px-5 py-2.5 text-sm font-semibold text-white shadow hover:bg-red-500 transition">
                Decline invitation
            </button>
        </form>
    </div>
</div>
{% endblock %}
