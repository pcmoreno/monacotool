<!DOCTYPE html>
<html lang="en" class="h-full bg-graphite-50">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="turbo-cache-control" content="no-cache">
        <title>{% block title %}MonacoTool{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <script>
            const t = localStorage.getItem('theme');
            if (t && t !== 'light') document.documentElement.setAttribute('data-theme', t);
        </script>
        {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="h-full flex flex-col">
        <header class="bg-header-bg text-header-fg px-6 py-3 flex items-center justify-between shrink-0">
            <div>
                <span class="font-semibold tracking-tight">Monaco Tool</span>
                <span class="text-header-muted text-sm ml-2">A simple forecasting tool for agile teams</span>
            </div>
            <div class="flex items-center gap-3">
                <div class="relative" id="theme-container">
                    <button type="button" id="theme-toggle"
                            class="flex items-center gap-1.5 rounded-md px-3 py-1.5 text-xs font-medium text-header-muted hover:text-header-fg hover:bg-header-hover transition">
                        <span id="theme-label">Light</span>
                        {% include 'icons/chevron-down.html.twig' %}
                    </button>
                    <div id="theme-menu"
                         class="hidden absolute right-0 mt-1 w-36 rounded-md shadow-lg bg-header-bg ring-1 ring-white/10 py-1 z-50">
                        <button data-theme-pick="light"
                                class="w-full text-left px-4 py-1.5 text-xs font-medium text-header-muted hover:text-header-fg hover:bg-header-hover transition">
                            Light
                        </button>
                        <button data-theme-pick="dark"
                                class="w-full text-left px-4 py-1.5 text-xs font-medium text-header-muted hover:text-header-fg hover:bg-header-hover transition">
                            Dark
                        </button>
                        <button data-theme-pick="forest"
                                class="w-full text-left px-4 py-1.5 text-xs font-medium text-header-muted hover:text-header-fg hover:bg-header-hover transition">
                            Forest
                        </button>
                    </div>
                </div>
                {% if app.user %}
                    <a href="{{ path('app_logout') }}"
                       class="rounded-md px-3 py-1.5 text-xs font-medium text-header-muted hover:text-header-fg hover:bg-header-hover transition">
                        Logout
                    </a>
                {% endif %}
            </div>
        </header>
        <div class="flex-1 overflow-y-auto">
            {% block body %}{% endblock %}
        </div>
        <script type="module" src="{{ asset('theme.js') }}"></script>
    </body>
</html>
